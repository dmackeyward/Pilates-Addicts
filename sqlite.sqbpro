((SELECT id FROM exercises WHERE slug = 'pulling-straps'), 'Regression', 'Lighter Spring / Choke Up', 'Use a lighter spring or hold strap rope above hardware to decrease lever weight.'),
((SELECT id FROM exercises WHERE slug = 'mermaid'), 'Regression', 'Cross-Legged Sitting', 'Sit cross-legged on carriage if hip tightness prevents side-saddle position.'),
((SELECT id FROM exercises WHERE slug = 'feet-in-straps-leg-circles'), 'Progression', 'Dumbwaiter / Arm Straps', 'Perform leg circles while holding small hand weights or maintaining tabletop arms.'),
((SELECT id FROM exercises WHERE slug = 'pelvic-curl'), 'Regression', 'Neutral Bridge', 'Lift and lower pelvis in flat neutral back without spinal articulation for disc sensitivity.');</sql><current_tab id="0"/></tab_sql></sqlb_project>
