-- Seed Guides (Overwrites if ID already exists)
INSERT OR REPLACE INTO `guides` (`id`, `title`, `slug`, `category`, `description`, `content`) VALUES
(1, 'Osteoporosis Protocol &amp; Safety Precautions', 'osteoporosis-protocol-and-safety-precautions', 'Pathology &amp; Safety', 'Essential modifications and contraindications when programming for clients with low bone density.', '### Core Principles\n1. **Avoid Flexion:** Eliminate forward spinal flexion under load.\n2. **Maintain Axial Elongation:** Focus on neutral spine alignment.\n3. **Extension Emphasis:** Encourage thoracic extension to support posture.'),
(2, 'Spring Resistance &amp; Gear Bar Mechanics', 'spring-resistance-and-gear-bar-mechanics', 'Apparatus Setup', 'Understanding leverage, spring weight adjustments, and gear positioning for various body proportions.', '### Gear Bar Selection\n- **1st Gear:** Shorter clients or those requiring less initial hip flexion.\n- **2nd Gear (Standard):** Most adult clients.\n- **3rd Gear:** Taller clients (6ft+) to prevent hip impingement.');

